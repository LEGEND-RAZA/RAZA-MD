{
  "name": "Raza-MD",
  "description": "Raza-MD WhatsApp Bot",
  "repository": "https://github.com/LEGEND-RAZA/RAZA-MD",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "raza-md"
  ],
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Short Raza-MD session ID generated by the pairing website",
      "required": true,
      "value": ""
    },
    "PAIR_SERVER_URL": {
      "description": "Raza-MD pairing server URL",
      "required": true,
      "value": "https://pair-web-3e08f4e68faf.herokuapp.com"
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "required": false,
      "value": "."
    },
    "OWNER_NUMBER": {
      "description": "Bot owner's WhatsApp number with country code",
      "required": false,
      "value": ""
    },
    "ALWAYS_ONLINE": {
      "description": "Keep WhatsApp presence online",
      "required": false,
      "value": "false"
    },
    "MODE": {
      "description": "Bot mode",
      "required": false,
      "value": "private"
    },
    "NODE_OPTIONS": {
      "description": "Node.js memory optimization",
      "required": false,
      "value": "--optimize_for_size --max_old_space_size=384"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
