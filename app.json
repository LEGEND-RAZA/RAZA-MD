{
  "name": "raza-md",
  "description": "Raza-MD WhatsApp Bot",
  "keywords": [
    "nodejs",
    "whatsapp",
    "baileys"
  ],
  "repository": "https://github.com/LEGEND-RAZA/RAZA-MD",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Raza-MD session ID",
      "required": true,
      "value": ""
    },
    "PAIR_SERVER_URL": {
      "description": "Raza-MD pairing server URL",
      "required": true,
      "value": "https://pair-web-3e08f4e68faf.herokuapp.com"
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "required": false,
      "value": "."
    },
    "HEROKU_API_KEY": {
      "description": "Heroku API key for GitHub updates",
      "required": false,
      "value": ""
    },
    "HEROKU_APP_NAME": {
      "description": "Heroku app name for GitHub updates",
      "required": false,
      "value": ""
    },
    "DB_HOST": {
      "description": "Aiven MySQL database host",
      "required": true,
      "value": "mysql-5075843-innoxcentraza51-73a9.h.aivencloud.com"
    },
    "DB_PORT": {
      "description": "Aiven MySQL database port",
      "required": true,
      "value": "26508"
    },
    "DB_NAME": {
      "description": "Aiven MySQL database name",
      "required": true,
      "value": "defaultdb"
    },
    "DB_USER": {
      "description": "Aiven MySQL database user",
      "required": true,
      "value": "avnadmin"
    },
    "DB_PASSWORD": {
      "description": "Aiven MySQL database password",
      "required": true,
      "value": "AVNS_qTijgdeJAe2yFVquIC9"
